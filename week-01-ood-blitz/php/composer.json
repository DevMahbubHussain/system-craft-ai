{
    "name": "craft/ood-sprint",
    "description": "Pure OOP systems (Parking Lot, Movie Booking, Vending Machine, Elevator) in PHP 8.2+",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\ParkingLot\\": "src/",
            "App\\MovieBooking\\": "src/MovieBooking/",
            "App\\VendingMachine\\": "src/VendingMachine/",
            "App\\Elevator\\": "src/Elevator/",
            "App\\ShoppingCart\\": "src/ShoppingCart/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}