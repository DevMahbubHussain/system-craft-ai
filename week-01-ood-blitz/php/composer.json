{
    "name": "craft/parking-lot",
    "description": "Pure OOP Parking Lot System in PHP 8.3+",
    "type": "project",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
